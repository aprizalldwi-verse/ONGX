{
  "name": "@ongx/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./genres": "./src/genres.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "dotenv -e ../../apps/web/.env.local -- prisma migrate dev",
    "deploy": "dotenv -e ../../apps/web/.env.local -- prisma migrate deploy",
    "reset": "dotenv -e ../../apps/web/.env.local -- prisma migrate reset --force",
    "seed": "dotenv -e ../../apps/web/.env.local -- tsx prisma/seed.ts",
    "studio": "dotenv -e ../../apps/web/.env.local -- prisma studio",
    "lint": "eslint src prisma",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "bcryptjs": "3.0.3",
    "dotenv-cli": "11.1.0",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
