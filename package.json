{
  "name": "ongx",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @ongx/web dev",
    "build": "pnpm --filter @ongx/web build",
    "start": "pnpm --filter @ongx/web start",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @ongx/db run generate",
    "db:migrate": "pnpm --filter @ongx/db run migrate",
    "db:deploy": "pnpm --filter @ongx/db run deploy",
    "db:seed": "pnpm --filter @ongx/db run seed",
    "db:studio": "pnpm --filter @ongx/db run studio",
    "catalog:sync": "pnpm --filter @ongx/web run catalog:sync",
    "e2e": "pnpm --filter @ongx/web run e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,md,css}": "prettier --write",
    "*.{ts,tsx}": "eslint --fix --max-warnings=0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "esbuild",
      "prisma"
    ]
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "15.5.29",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
