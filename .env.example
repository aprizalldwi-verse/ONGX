# --- Core -------------------------------------------------------------------
DATABASE_URL="postgresql://ongx:ongx@localhost:5432/ongx?schema=public"
DIRECT_URL="postgresql://ongx:ongx@localhost:5432/ongx?schema=public"
REDIS_URL="redis://localhost:6379"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Catalog ----------------------------------------------------------------
# TMDB v3 API key. Unit test memakai fixture, jadi key kosong tetap lolos gate.
# Isi key asli untuk menjalankan `pnpm --filter @ongx/web tmdb:smoke` (live, butuh jaringan).
TMDB_API_KEY=""
TMDB_REGION="ID"

# --- Ads (Monetag) ----------------------------------------------------------
# Leave empty to disable a zone. The layout must work with all of them empty.
NEXT_PUBLIC_MT_SMART=""
NEXT_PUBLIC_MT_PUSH=""
NEXT_PUBLIC_MT_VIGNETTE=""
NEXT_PUBLIC_MT_INTERSTITIAL=""
NEXT_PUBLIC_MT_POPUNDER=""
NEXT_PUBLIC_MT_REWARDED=""
NEXT_PUBLIC_MT_NATIVE=""

# --- Ops --------------------------------------------------------------------
CRON_SECRET=""
ADMIN_USER="admin"
# Only used by `pnpm db:seed`; hashed into ADMIN_PASS_HASH on first run.
ADMIN_PASS=""
# bcrypt hash, generate with: pnpm --filter @ongx/web exec tsx scripts/hash-password.ts
ADMIN_PASS_HASH=""
