# --- Core -------------------------------------------------------------------
DATABASE_URL="postgresql://ongx:ongx@localhost:5432/ongx?schema=public"
DIRECT_URL="postgresql://ongx:ongx@localhost:5432/ongx?schema=public"
REDIS_URL="redis://localhost:6379"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Catalog ----------------------------------------------------------------
# TMDB v3 API key. Unit test memakai fixture, jadi key kosong tetap lolos gate.
# Isi key asli untuk menjalankan `pnpm --filter @ongx/web tmdb:smoke` (live, butuh jaringan).
TMDB_API_KEY=""
TMDB_REGION="ID"

# --- Ads (Monetag) ----------------------------------------------------------
# Master switch. `false` (or empty) keeps every slot out of the layout, which is
# what the CLS e2e test asserts. Turn on only after the network approves zones.
NEXT_PUBLIC_ADS_ENABLED="false"
# Account-specific bridge implementing window.ongxAds; see docs/ads.md.
NEXT_PUBLIC_MT_ADAPTER_URL=""
# Leave empty to disable a zone. The layout must work with all of them empty.
NEXT_PUBLIC_MT_SMART=""
NEXT_PUBLIC_MT_PUSH=""
NEXT_PUBLIC_MT_VIGNETTE=""
NEXT_PUBLIC_MT_INTERSTITIAL=""
NEXT_PUBLIC_MT_POPUNDER=""
NEXT_PUBLIC_MT_REWARDED=""
NEXT_PUBLIC_MT_NATIVE=""

# --- Worker (Phase 9) --------------------------------------------------------
# Repeatable jobs: catalog sync, provider-offer refresh, sync-history cleanup.
# Redis is required; the worker exits with a readable error when it is missing.
WORKER_CONCURRENCY="2"
WORKER_QUEUE_PREFIX="ongx"
# Cron patterns are UTC. Every schedule is upserted on boot, so editing them
# here and restarting the worker is enough.
WORKER_CATALOG_CRON="0 2 * * *"
WORKER_OFFERS_CRON="0 */6 * * *"
WORKER_CLEANUP_CRON="30 3 * * *"
WORKER_SYNC_TMDB="100"
WORKER_SYNC_ANILIST="60"
WORKER_SYNC_FORCE="false"
WORKER_OFFERS_LIMIT="50"
WORKER_OFFERS_MAX_AGE_HOURS="24"
WORKER_RETENTION_DAYS="30"
# Set to "true" in deployments where a missing heartbeat should degrade the
# health endpoint. Leave empty when the worker is not deployed.
WORKER_HEALTH_REQUIRED=""

# --- Ops --------------------------------------------------------------------
CRON_SECRET=""
ADMIN_USER="admin"
# Only used by `pnpm db:seed`; hashed into ADMIN_PASS_HASH on first run.
ADMIN_PASS=""
# bcrypt hash, generate with: pnpm --filter @ongx/web exec tsx scripts/hash-password.ts
ADMIN_PASS_HASH=""
