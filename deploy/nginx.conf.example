# ONGX reverse proxy. Adjust the domain and certificate paths, then:
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/ongx
#   sudo ln -s /etc/nginx/sites-available/ongx /etc/nginx/sites-enabled/ongx
#   sudo nginx -t && sudo systemctl reload nginx
#
# TLS certificates are issued by certbot (`certbot --nginx -d ongx.example`).
# The app itself sends HSTS in production, so it is not duplicated here.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name ongx.example;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ongx.example;

    ssl_certificate     /etc/letsencrypt/live/ongx.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ongx.example/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Admin actions are capped at 512 kb and reports at 16 KiB; keep a small
    # margin without accepting multi-megabyte uploads (the app has none).
    client_max_body_size 2m;

    # Static assets are content-hashed by Next and safe to cache forever.
    location /_next/static/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        # Overwrite (not append) so clients cannot spoof the IP used by rate
        # limiting. See docs/security.md and ASUMSI-061/068.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
